# Frontend build-time configuration. Copy to `.env` for local `npm run dev`.
#
# Vite inlines every VITE_-prefixed variable into the bundle that ships to the
# browser, so nothing secret goes here: no JWT secret, no database URL, no
# admin key.

# Base URL of the API Gateway, read by src/lib/config.ts. Leave it empty:
# requests then use relative paths on the page's own origin, and `npm run dev`
# proxies /api and /auth to the gateway on localhost:8080 (vite.config.ts).
#
# A non-empty value makes every request cross-origin. fetch then sends no
# cookies, so the session cannot be refreshed, and every call needs CORS
# headers, which the gateway does not send.
VITE_GATEWAY_BASE_URL=

# Set to `true` to run the in-browser fixtures instead of a real backend. Any
# other value, including empty, uses the gateway.
VITE_USE_FIXTURES=
