# Frontend build-time configuration. Copy to `.env` for local `npm run dev`.
#
# Vite inlines every VITE_-prefixed variable into the bundle that ships to the
# browser, so NOTHING SECRET GOES HERE — no JWT secret, no database URL, no
# admin key (frontend/AGENTS.md, Gotchas).

# The API Gateway (ai/decisions.md D-010).
#
# LEAVE THIS EMPTY. Empty means "same origin", which is what D-033 requires:
# the gateway serves the built app in Compose, and `npm run dev` proxies
# /api and /auth to it (vite.config.ts). Relative paths are correct.
#
# Set it only to aim a dev build at a gateway elsewhere. That makes requests
# cross-origin again and the SameSite=Strict refresh cookie will not be sent,
# so login will appear to work and then drop the session.
VITE_GATEWAY_BASE_URL=

# Run the in-browser fixtures instead of a real backend. Opt-in, and the only
# way to get them: an empty gateway URL no longer implies them.
#   VITE_USE_FIXTURES=true
VITE_USE_FIXTURES=
