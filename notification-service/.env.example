# Tool: Claude Code (model: Opus 5.5), date: 2026-11-05
# Scope: notification-service's environment for a host run.
# Author review: PENDING — <reviewer to complete>

# For a host run (`go run ./cmd/api`); compose.yaml sets its own in-network
# values. The service reads its process environment and does not load this file.
PORT=8086
NOTIFICATION_DB_URL=postgres://notification:notification@localhost:5432/notifications?sslmode=disable

# The broker it consumes from, queue notification.errands.
RABBITMQ_URL=amqp://foc:foc-dev-password@localhost:5672/foc

# Token checks: user-service's public keys and the shared revocation keys.
JWKS_URL=http://localhost:8081/.well-known/jwks.json
REDIS_URL=redis://localhost:6379

# C, stated in the delivered notification. Keep it equal to order-service's.
ORDER_CONFIRMATION_WINDOW=24h
