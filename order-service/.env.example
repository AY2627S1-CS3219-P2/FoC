# order-service's environment for a host run (`go run ./cmd/api`); compose.yaml
# sets its own in-network values. The service reads its process environment and
# does not load this file.
PORT=8083
ORDER_DB_URL=postgres://postgres:postgres@localhost:5432/orders?sslmode=disable

# The services it calls.
SUPPLIER_BASE_URL=http://localhost:8082
CREDIT_BASE_URL=http://localhost:8084
# AI-generated (edited by PENDING): user-service keeps each courier's ranking model (D-099).
USER_BASE_URL=http://localhost:8081

# The broker the outbox relay publishes to, exchange foc.events.
RABBITMQ_URL=amqp://foc:foc-dev-password@localhost:5672/foc

# Where user-service publishes the keys access tokens are verified with, and the
# shared Redis holding its revocation keys.
JWKS_URL=http://localhost:8081/.well-known/jwks.json
REDIS_URL=redis://localhost:6379

# T, K and C: how long an errand stays OPEN before it expires, how many errands
# a courier may hold in ACCEPTED or PICKED_UP, and how long a requester has to
# confirm a delivery. Durations use Go syntax (2h, 30s).
ORDER_EXPIRY_PERIOD=2h
ORDER_MAX_ACTIVE_ASSIGNMENTS=2
ORDER_CONFIRMATION_WINDOW=24h
