# API Gateway configuration for local `go run ./cmd/api`. The gateway reads
# only the process environment and does not load a .env file itself.
# All variables are required except STATIC_DIR.

# ---- Listener -----------------------------------------------
# Port the gateway listens on.
PORT=8080

# ---- Token verification -------------------------------------
# user-service's JWKS endpoint. The gateway fetches the RSA public keys it
# verifies access tokens with from here, on first use. While it is
# unreachable, authenticated routes return 503.
JWKS_URL=http://localhost:8081/.well-known/jwks.json

# ---- Downstream services ------------------------------------
# Base URL of each service the gateway forwards to. All four are required.
USER_BASE_URL=http://localhost:8081
SUPPLIER_BASE_URL=http://localhost:8082
ORDER_BASE_URL=http://localhost:8083
CREDIT_BASE_URL=http://localhost:8084


# Max-Age of the refresh-token cookie, as a Go duration (e.g. 168h).
# Must equal user-service's JWT_REFRESH_TOKEN_TTL.
REFRESH_TOKEN_TTL=168h

# Directory of the built frontend, served at "/". Optional: leave empty to
# serve API routes only.
STATIC_DIR=
