# API Gateway configuration. Copy to `.env` for local `go run ./cmd/api`.
#
# Every variable below is REQUIRED — the gateway refuses to start rather than
# fall back to a default, so a missing value fails loudly at boot instead of
# silently addressing the wrong thing.

# ---- Listener -----------------------------------------------
# PROVISIONAL (D-018). 8081-8084 are the services, 3001 is the frontend.
PORT=8080

# ---- Token verification -------------------------------------
# user-service's JSON Web Key Set (D-023). The gateway fetches the RSA PUBLIC
# keys from here and verifies RS256 signatures with them.
#
# There is deliberately NO private key and NO shared secret in this file. The
# gateway can verify a token but cannot mint one, which is what keeps
# user-service the sole issuer (D-012).
#
# Fetched lazily on first use, not at boot, so the gateway does not depend on
# user-service being up first (root AGENTS.md §5). While it is unreachable,
# authenticated routes return 503 and the auth routes still work.
JWKS_URL=http://localhost:8081/.well-known/jwks.json

# ---- Downstream services ------------------------------------
# One base URL per callee (root AGENTS.md §3). All four are required even
# though some services do not exist yet: a missing one should fail at boot,
# not at the first request that needs it.
USER_BASE_URL=http://localhost:8081
SUPPLIER_BASE_URL=http://localhost:8082
ORDER_BASE_URL=http://localhost:8083
CREDIT_BASE_URL=http://localhost:8084

# ---- Not here, on purpose -----------------------------------
# REDIS_URL: the gateway is not a Redis client (D-024). user-service is the
#   only process that talks to it.
# JWT_SECRET: replaced by JWKS_URL above (D-023). A symmetric secret would let
#   the gateway issue tokens, breaking D-012.
