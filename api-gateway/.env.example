# API Gateway configuration. Copy to `.env` for local `go run ./cmd/api`.
#
# Every variable below is REQUIRED — the gateway refuses to start rather than
# fall back to a default, so a missing value fails loudly at boot instead of
# silently addressing the wrong thing.

# ---- Listener -----------------------------------------------
# PROVISIONAL (D-018). 8081-8084 are the services, 3001 is the frontend.
PORT=8080

# ---- Revocation store ---------------------------------------
# The gateway OWNS this Redis (D-017). No other service gets this string.
# Holds only the jti blocklist and suspended:<uid> keys — no credentials, no
# refresh tokens, no profile data. Separate from every service's Postgres.
REDIS_URL=redis://localhost:6379

# ---- Token verification -------------------------------------
# Same secret user-service signs with (D-011, D-012). NEVER commit a real value.
JWT_SECRET=

# ---- Downstream services ------------------------------------
# One base URL per callee (root AGENTS.md §3).
USER_BASE_URL=http://localhost:8081
SUPPLIER_BASE_URL=http://localhost:8082
ORDER_BASE_URL=http://localhost:8083
CREDIT_BASE_URL=http://localhost:8084
