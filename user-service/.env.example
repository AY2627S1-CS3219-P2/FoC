PORT=8081
JWT_KEYSET_PATH=./keys.json
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
REDIS_URL=redis://redis:6379/0
USER_DB_URL=postgres://postgres:postgres@localhost:5432/user?sslmode=disable
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# sendgrid (the default when unset) needs the SENDGRID_* values below; log writes
# verification codes to the service log instead, for local runs only.
OTP_DELIVERY=log
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=
# Broker the outbox relay publishes events to; unset means this value.
RABBITMQ_URL=amqp://foc:foc-dev-password@localhost:5672/foc

# Compose inputs
# USER_SRV_DB_USER=postgres
# USER_SRV_DB_PW=postgres
