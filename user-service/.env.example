PORT=8081
JWT_KEYSET_PATH=./keys.json
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
REDIS_URL=redis://redis:6379/0
USER_DB_URL=postgres://postgres:postgres@localhost:5432/user?sslmode=disable
# AI-generated (edited by PENDING): the separate ranking-model database (D-095).
