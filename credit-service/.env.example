# Local host-run defaults for credit-service.
#
# Use this file as a template when running credit-service directly with
# `go run ./cmd/api` from this folder. Docker Compose sets container-specific
# values in the root `compose.yaml`, so these localhost URLs are not the values
# containers use on the Docker network.

# HTTP port used when the service is run directly on your machine.
PORT=8084

# PostgreSQL connection string used by direct local runs.
CREDIT_DB_URL=postgres://credit:credit@localhost:5432/credit?sslmode=disable

# user-service JWKS endpoint used to verify forwarded Bearer JWTs locally.
JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Shared Redis endpoint used to check token revocation lists.
REDIS_URL=redis://localhost:6379

# RabbitMQ connection URL used by direct local runs.
RABBITMQ_URL=amqp://foc:foc-dev-password@localhost:5672/foc

# Apply database migrations on service startup (true for local dev, false for multi-replica prod).
RUN_MIGRATIONS=true

# Background worker retry intervals for pending settlements and periodic audits.
PAYOUT_RETRY_INTERVAL=1m
REFUND_RETRY_INTERVAL=1m
RECONCILIATION_INTERVAL=5m

# Thresholds after which overdue pending settlements emit structured alerts.
PAYOUT_ALERT_AFTER=15m
REFUND_ALERT_AFTER=15m

# Keyset batch claim sizes for background processing loops.
PAYOUT_BATCH_SIZE=50
REFUND_BATCH_SIZE=50
RECONCILIATION_BATCH_SIZE=500

# Consumer and worker pool concurrency limits.
WORKER_CONCURRENCY=2
PAYOUT_WORKER_CONCURRENCY=2
REFUND_WORKER_CONCURRENCY=2
