# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
# RS256 (D-023). user-service holds the private key and is the sole issuer
# (D-012); the gateway gets only the public half, via JWKS_URL below.
# NEVER commit a real key.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# 15 minutes and 7 days per user-service's AGENTS.md.
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ---- API Gateway (D-010) -----------------------------------
# The only publicly reachable process. Port is PROVISIONAL (D-018).
GATEWAY_PORT=8080

# user-service's JWKS endpoint. The gateway fetches RSA PUBLIC keys from here
# and verifies RS256 access tokens with them (D-023). No private key and no
# shared secret reach the gateway, so it cannot mint a token (D-012).
JWKS_URL=http://localhost:8081/.well-known/jwks.json

# One base URL per callee, read by the gateway (root AGENTS.md §3).
USER_BASE_URL=http://localhost:8081
SUPPLIER_BASE_URL=http://localhost:8082
ORDER_BASE_URL=http://localhost:8083
CREDIT_BASE_URL=http://localhost:8084

# ---- Revocation store --------------------------------------
# Redis. Written and read by user-service ONLY (D-024) — the gateway is not a
# Redis client. Holds the jti blocklist and suspension keys.
REDIS_URL=redis://localhost:6379

# ... Add more variables as needed
