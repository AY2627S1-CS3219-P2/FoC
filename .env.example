# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=
JWT_REFRESH_TOKEN_TTL=

# ---- Frontend (build-time) ---------------------------------
# Vite inlines every VITE_-prefixed variable into the browser bundle at BUILD
# time. Never put a secret behind a VITE_ prefix.
#
# D-010 puts every service behind the gateway, so the browser should need ONE
# URL. Left empty on purpose: App.tsx reads empty as "run the fixture auth",
# and setting it is what switches the app onto the real flow.
VITE_GATEWAY_BASE_URL=

# TRANSITIONAL — remove once the gateway forwards. supplier-service is still
# reached directly because api-gateway/internal/proxy is an empty scaffold.
VITE_SUPPLIER_BASE_URL=

# ... Add more variables as needed
