# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
#
# NOTE: the provided URLs and paths are strictly for local host execution.
#       `compose.yaml` automatically substitutes them with internal Docker routing
#       during containerized deployments.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
JWT_KEYSET_PATH=./user-service/keys.json
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ---- PostgreSQL ------------
USER_SRV_DB_USER=postgres
USER_SRV_DB_PW=postgres
USER_DB_URL=postgres://postgres:postgres@localhost:5432/user?sslmode=disable

# ---- Initial admin ---------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# ---- Mailgun ---------------
# How user-service sends verification codes: `mailgun` (its default when unset)
# needs the three MAILGUN_* values; `log` writes codes to the user-service log
# instead, for local runs only, and is what Compose passes when this is unset.
OTP_DELIVERY=log
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SENDER_EMAIL=

# ---- API Gateway -------------------------------------------
# user-service's JWKS endpoint; the gateway, order-service and supplier-service
# fetch the public keys they verify access tokens with from here.
JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Base URL of each downstream service, read by the gateway.
USER_BASE_URL=http://localhost:8081
SUPPLIER_BASE_URL=http://localhost:8082
# supplier-service reads ORDER_BASE_URL too, to check for unfinished errands
# before deleting a supplier.
ORDER_BASE_URL=http://localhost:8083
CREDIT_BASE_URL=http://localhost:8084

# ---- Redis -------------------------------------------------
# user-service writes the access-token revocation keys here, and the gateway,
# order-service and supplier-service read them.
REDIS_URL=redis://localhost:6379

# ---- Supplier service --------------------------------------
# For a host run of supplier-service (from supplier-service/); compose.yaml sets
# the in-network values. It also reads ORDER_BASE_URL (API Gateway section above)
# and JWKS_URL and REDIS_URL, which it needs to verify an admin's token.
SUPPLIER_DB_URL=postgres://postgres:postgres@localhost:5432/supplier?sslmode=disable
SEED_CSV_PATH=../data/csv/supplier-seed-data.csv

# ---- Order service -----------------------------------------
# For a host run of order-service; compose.yaml sets the in-network values.
# order-service also reads SUPPLIER_BASE_URL, CREDIT_BASE_URL and JWKS_URL from
# the API Gateway section above and REDIS_URL from the Redis section.
# Its RABBITMQ_URL is in the RabbitMQ section below.
ORDER_DB_URL=postgres://postgres:postgres@localhost:5432/orders?sslmode=disable
# How long an errand stays open (T), how many errands a courier may hold (K) and
# how long a requester has to confirm a delivery (C). Compose reads these three
# from here or the shell; the e2e suite starts the stack with T and C in
# seconds (e2e/README.md).
ORDER_EXPIRY_PERIOD=2h
ORDER_MAX_ACTIVE_ASSIGNMENTS=2
ORDER_CONFIRMATION_WINDOW=24h

# ---- Frontend (build-time) ---------------------------------
# Vite inlines every VITE_-prefixed variable into the browser bundle at build
# time. Never put a secret behind a VITE_ prefix.
#
# Base URL of the API Gateway. Empty means requests use relative paths on the
# page's own origin; see frontend/.env.example.
VITE_GATEWAY_BASE_URL=

VITE_SUPPLIER_BASE_URL=

# ---- RabbitMQ ------------------------------------------------
RABBITMQ_DEFAULT_USER=foc
RABBITMQ_DEFAULT_PASS=foc-dev-password
RABBITMQ_DEFAULT_VHOST=foc
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://foc:foc-dev-password@localhost:5672/foc

# ... Add more variables as needed
